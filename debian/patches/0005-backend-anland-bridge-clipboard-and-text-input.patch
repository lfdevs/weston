+		return NULL;
+	}
+
+	if (poll_input_event_extend_data(b->display, text, size,
+					 EXTENDED_INPUT_TIMEOUT_MS) != 1) {
+		free(text);
+		return NULL;
+	}
+	text[size] = '\0';
+
+	if (memchr(text, '\0', size) || !anland_valid_utf8(text, size)) {
+		weston_log("anland: rejected invalid UTF-8 %s payload\n", name);
+		free(text);
+		return NULL;
+	}
+
+	return text;
+}
