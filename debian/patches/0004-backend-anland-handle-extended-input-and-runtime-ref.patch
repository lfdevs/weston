                                 int *fd_count, int timeout_ms)
@@ -390,8 +442,10 @@ int poll_input_event_extend_fds(display_ctx *ctx, int *fds, int max_fds,
 
     struct pollfd pfd = { .fd = ctx->data_fd, .events = POLLIN };
     int ret = poll(&pfd, 1, timeout_ms);
-    if (ret <= 0)
-        return 0;
+    if (ret <= 0) {
+        enter_fallback(ctx);
+        return -1;
+    }
 
     if (pfd.revents & (POLLHUP | POLLERR | POLLNVAL)) {
         enter_fallback(ctx);
@@ -481,16 +535,7 @@ int poll_input_event_extend_data(display_ctx *ctx, void *payload, size_t size, i
     if (!payload)
         return -1;
 
-    struct pollfd pfd = { .fd = ctx->data_fd, .events = POLLIN };
-    int ret = poll(&pfd, 1, timeout_ms);
-    if (ret <= 0)
-        return 0;
-
-    if (pfd.revents & (POLLHUP | POLLERR | POLLNVAL)) {
-        enter_fallback(ctx);
-        return -1;
-    }
-    if (recv_all(ctx->data_fd, payload, size) < 0) {
+    if (recv_all_timeout(ctx->data_fd, payload, size, timeout_ms) < 0) {
         enter_fallback(ctx);
         return -1;
