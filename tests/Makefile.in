wayland_protocoldir = $(top_srcdir)/protocol
all: $(BUILT_SOURCES)
	$(MAKE) $(AM_MAKEFLAGS) all-am

.SUFFIXES:
.SUFFIXES: .c .la .la$(EXEEXT) .lo .log .o .obj .trs .weston .weston$(EXEEXT)
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am $(top_srcdir)/wayland-scanner.mk $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign tests/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign tests/Makefile
.PRECIOUS: Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe);; \
	esac;
$(top_srcdir)/wayland-scanner.mk:

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

clean-checkLTLIBRARIES:
	-test -z "$(check_LTLIBRARIES)" || rm -f $(check_LTLIBRARIES)
	@list='$(check_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

clean-noinstLTLIBRARIES:
	-test -z "$(noinst_LTLIBRARIES)" || rm -f $(noinst_LTLIBRARIES)
	@list='$(noinst_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

libshared-test.la: $(libshared_test_la_OBJECTS) $(libshared_test_la_DEPENDENCIES) $(EXTRA_libshared_test_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libshared_test_la_LINK)  $(libshared_test_la_OBJECTS) $(libshared_test_la_LIBADD) $(LIBS)

surface-global-test.la: $(surface_global_test_la_OBJECTS) $(surface_global_test_la_DEPENDENCIES) $(EXTRA_surface_global_test_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(surface_global_test_la_LINK)  $(surface_global_test_la_OBJECTS) $(surface_global_test_la_LIBADD) $(LIBS)

surface-test.la: $(surface_test_la_OBJECTS) $(surface_test_la_DEPENDENCIES) $(EXTRA_surface_test_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(surface_test_la_LINK)  $(surface_test_la_OBJECTS) $(surface_test_la_LIBADD) $(LIBS)

weston-test.la: $(weston_test_la_OBJECTS) $(weston_test_la_DEPENDENCIES) $(EXTRA_weston_test_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(weston_test_la_LINK)  $(weston_test_la_OBJECTS) $(weston_test_la_LIBADD) $(LIBS)

clean-noinstPROGRAMS:
	@list='$(noinst_PROGRAMS)'; test -n "$$list" || exit 0; \
	echo " rm -f" $$list; \
	rm -f $$list || exit $$?; \
	test -n "$(EXEEXT)" || exit 0; \
	list=`for p in $$list; do echo "$$p"; done | sed 's/$(EXEEXT)$$//'`; \
	echo " rm -f" $$list; \
	rm -f $$list

